# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Proveedor de Inteligencia Artificial (Google Gemini - SDK @google/genai)
# Obtén tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=8000
# Tiempo total máximo de /api/chat (Gemini + TTS). Debe ser menor que el readTimeout de la app (25 s).
# Si Gemini consume demasiado, se omite la voz neural y la app usa su TTS local.
CHAT_RESPONSE_BUDGET_MS=18000
# Nivel de razonamiento opcional: off | minimal | low | medium | high | default
# (Por defecto usa 'off' en modelos Flash 2.5+ para mínima latencia)
# GEMINI_THINKING_LEVEL=off

# Seguridad de la API
# Token compartido con la app Android (Authorization: Bearer <token>). Obligatorio con NODE_ENV=production.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_ACCESS_TOKEN=
# Límite de peticiones por IP y minuto
CHAT_RATE_LIMIT_PER_MINUTE=20
SESSION_RATE_LIMIT_PER_MINUTE=30
# Orígenes web permitidos por CORS, separados por coma (vacío = sin CORS; la app Android no lo necesita)
CORS_ORIGINS=
# Activa si el backend corre detrás de un proxy (ngrok, Render, Nginx), p. ej. TRUST_PROXY=1
# TRUST_PROXY=1

# Persistencia e Historial de Sesiones
# SESSION_STORE: file (persiste en disco) | redis (producción) | memory (solo RAM)
SESSION_STORE=file
SESSION_FILE_PATH=./data/sessions.json
# REDIS_URL=redis://localhost:6379
SESSION_MAX_MESSAGES=6
SESSION_TTL_MINUTES=60
