<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de copia de seguridad y transferencia (Android 12+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- El sessionId es único por instalación: no se copia ni se transfiere a otro dispositivo -->
    <cloud-backup>
        <exclude domain="sharedpref" path="care_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="care_session.xml" />
    </device-transfer>
</data-extraction-rules>
